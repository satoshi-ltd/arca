{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arca",
  "version": "0.6.0",
  "identifier": "com.soyjavi.arca",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run ui",
    "devUrl": "http://127.0.0.1:1425"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arca",
        "width": 1080,
        "height": 740,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#F4F6F1",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1425; object-src 'none'; base-uri 'none'; frame-src 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": [
      "runtime/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/satoshi-ltd/arca/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QUY4MjBEQjhFRENFNTgKUldSWXp1MjREWUt2OWdhZ001aDN4SmZBaFZ1SWlWbWVpTWpMZ1Y3dzhTcGlFb1ZsKzlaSUcvS3AK",
      "dialog": false
    }
  }
}
