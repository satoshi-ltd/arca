{
  "expo": {
    "name": "arca",
    "slug": "arca",
    "version": "0.6.119",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.satoshilimited.arca",
      "buildNumber": "28",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSLocalNetworkUsageDescription": "Connect to your Arca hub over your private network.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.satoshilimited.arca",
      "versionCode": 28,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#244d3e",
        "monochromeImage": "./assets/monochrome-icon.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-dev-client",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#244d3e",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Arca reads the albums you link, or your whole library, to upload their photos and videos to your hub.",
          "cameraPermission": "Arca does not use the camera.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "*/*"
            ],
            "multipleShareMimeTypes": [
              "*/*"
            ]
          },
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsFileWithMaxCount": 20,
              "supportsImageWithMaxCount": 20,
              "supportsMovieWithMaxCount": 20,
              "supportsAttachmentsWithMaxCount": 20
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f4f6f1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0f1512"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Arca reads the albums you link, or your whole library, to upload their photos and videos to your hub.",
          "savePhotosPermission": "Arca never saves to your photo library.",
          "granularPermissions": [
            "photo",
            "video"
          ],
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video"
    ],
    "icon": "./assets/icon.png",
    "scheme": "arca",
    "owner": "satoshi-ltd",
    "extra": {
      "eas": {
        "projectId": "797cbf21-73d8-4d82-bdf6-42c05e2cdff2"
      }
    }
  }
}
