{
  "name": "arca-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client --scheme arca",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "check": "expo export --platform ios --platform android",
    "postinstall": "node scripts/prepare-native.cjs",
    "eas:login": "npx -y eas-cli login",
    "eas:whoami": "npx -y eas-cli whoami",
    "eas:init": "npx -y eas-cli project:init",
    "build:dev": "npx -y eas-cli build --platform android --profile development",
    "build:preview": "npx -y eas-cli build --platform android --profile preview",
    "build:prod": "npx -y eas-cli build --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/fragment-mono": "^0.4.0",
    "@expo-google-fonts/instrument-sans": "^0.4.0",
    "@noble/hashes": "^2.0.1",
    "base64-js": "^1.5.1",
    "expo": "~55.0.26",
    "expo-background-task": "~55.0.22",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-network": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.14",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.21",
    "expo-sqlite": "~55.0.0",
    "expo-task-manager": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.15.3"
  },
  "type": "module"
}
