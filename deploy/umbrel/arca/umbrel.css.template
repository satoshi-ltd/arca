#access-form {
  display: flex;
  flex-direction: column;
  text-align: left;
  gap: var(--space-2);
}
#access-form .session-note,
#access-form .primary {
  margin-top: 0;
}
#access-form .primary {
  margin-top: var(--space-3);
}
#result {
  margin-top: var(--space-5);
}
#code {
  display: block;
  font: var(--access-reference-font) var(--font-mono);
  letter-spacing: var(--space-1);
  user-select: all;
}
.return-link {
  display: inline-block;
  margin-top: var(--space-4);
  font-size: var(--text-control);
}
#error {
  color: var(--erFg);
  font-size: var(--text-control);
}
#error:empty {
  display: none;
}
