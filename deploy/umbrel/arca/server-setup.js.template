import fs from "node:fs";
import path from "node:path";
import os from "node:os";
import { fail, init, atomic } from "./storage.js";

// Bootstrap an idle server for the shared authenticated first-run wizard.
// Existing configurations (including interrupted onboarding) are never rewritten.
export function initializeServer(home, options = {}) {
  fs.mkdirSync(home, { recursive: true, mode: 0o700 });
  const file = path.join(home, "config.json");
  if (fs.existsSync(file)) {
    const config = JSON.parse(fs.readFileSync(file, "utf8"));
    if (config.installation !== "server")
      fail(
        "Server startup requires server state; configuration was not changed.",
      );
    return config;
  }
  if (fs.readdirSync(home).some((name) => name !== ".gitkeep"))
    fail(
      "State exists without its configuration. Restore it before starting Arca.",
    );
  const config = init(home, {
    ...options,
    installation: "server",
    role: "replica",
    root: options.root || process.env.ARCA_FILES || path.join(home, "files"),
    onboarding: true,
  });
  // The daemon starts only after this write. onboarding also keeps it idle if
  // bootstrap is interrupted between the two atomic configuration writes.
  config.needsSetup = true;
  config.onboarding = false;
  atomic(file, JSON.stringify(config, null, 2));
  return config;
}

export function inspectSetupRoot(value, home) {
  if (typeof value !== "string" || !value.trim()) fail("Choose a folder root");
  if (value === "~" || value.startsWith("~/"))
    value = path.join(os.homedir(), value.slice(2));
  if (!path.isAbsolute(value)) fail("Choose an absolute folder path");
  const root = path.resolve(value);
  let existing = root;
  while (!fs.existsSync(existing)) existing = path.dirname(existing);
  const resolved = path.resolve(
    fs.realpathSync(existing),
    path.relative(existing, root),
  );
  const state = fs.existsSync(home)
    ? fs.realpathSync(home)
    : path.resolve(home);
  if (resolved === state || state.startsWith(resolved + path.sep))
    fail("Choose a folder outside Arca's state directory");
  if (process.env.ARCA_FILES) {
    const persistent = fs.realpathSync(process.env.ARCA_FILES);
    if (resolved !== persistent && !resolved.startsWith(persistent + path.sep))
      fail("Choose a folder inside persistent server storage: " + persistent);
  }
  if (
    fs.existsSync(root) &&
    (!fs.statSync(root).isDirectory() ||
      fs.readdirSync(root).some((name) => name !== ".DS_Store"))
  )
    fail("Choose an empty or new folder root");
  fs.accessSync(existing, fs.constants.W_OK | fs.constants.X_OK);
  const disk = fs.statfsSync(existing);
  return { root: resolved, freeBytes: disk.bavail * disk.bsize };
}
