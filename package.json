{
  "name": "arca",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "arca": "packages/cli/arca.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "arca": "node packages/cli/arca.js",
    "desktop": "node scripts/desktop-dev.js",
    "desktop:release": "node scripts/build-release.js",
    "desktop:build": "node scripts/stage-runtime.js && cd apps/desktop && tauri build",
    "verify:bundle": "node scripts/verify-bundle.js",
    "format": "prettier --write packages apps/desktop/src scripts tests SPEC.md README.md AGENTS.md package.json compose.yaml",
    "postdesktop:build": "node scripts/sign-local.js",
    "dev": "npm run desktop",
    "dev:clean": "node scripts/desktop-dev.js --clean",
    "mobile": "npm --prefix apps/mobile start -- --lan",
    "desktop:ui": "vite --config apps/desktop/vite.config.js",
    "mobile:build": "npm --prefix apps/mobile run build:dev",
    "mobile:build:preview": "npm --prefix apps/mobile run build:preview",
    "update-docker": "node scripts/local/update-docker.js",
    "update-umbrel": "python3 scripts/local/update-umbrel.py",
    "site:build": "node site/scripts/build.mjs",
    "build:site": "npm run site:build",
    "site:release": "node site/scripts/read-release.mjs",
    "mobile:build:dev": "node scripts/mobile-build.js dev",
    "mobile:build:prod": "node scripts/mobile-build.js prod"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@noble/hashes": "2.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "jsdom": "^30.0.1",
    "lucide": "^0.460.0",
    "prettier": "^3.9.6",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "ffmpeg-static": "5.3.0",
    "sharp": "^0.35.4"
  }
}
